#.env.example
#1. Copia este archivo y renombralo a env.(sin example)
#2. LLena Los Valores de Tu equipo
#3. el archivo .env NUNCA se sube a Github 

#LLave para firmar La sesion. Por una frase larga y diferente por equipo.

SECRET_KEY=cambia-esta-frase-p-una-larga-y-secreta

# 1 = modo desarollo (errores detallados y ruta /dev/entrar). En Render va 0

MODO_DESARROLLO=1

# --- BASE DE DATOS ---
#Opcion A: XAMMP Local -> DB_HOST=Localhost DB_PORT=3306 DB_USER= root DB_PASSWORD= (vacio)
#Opcion B: Aiven       -> Los datos de "Connetion information" del servicio

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Cada equipo usa la suya: asist_e1, asist_e2 ... asist_e6
DB_NAME=asist_e1

# Solo para Aiven: ruta al archivo ca.pem que se descarga del servicio. Con XAMPP déjalo vacío.
DB_SSL_CA=


# --- Clave que manda el ESP32 en el encabezado X-Clave-Dispositivo ---
CLAVE_DISPOSITIVO=clave-de-prueba-esp32